<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/bg_circle_green_light">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:contentDescription="Google Sign-In"
            android:src="@drawable/ic_google_logo" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvCallbackTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-bold"
        android:text="Signing in with Google"
        android:textColor="#0F172A"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvCallbackSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif"
        android:text="Verifying account and connecting to AroundUS..."
        android:textColor="#64748B"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/progressBarCallback"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="32dp"
        android:indeterminateTint="#16A34A" />

</LinearLayout>
