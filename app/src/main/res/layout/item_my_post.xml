<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="9dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="#EEF2F6"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- Top Header: Avatar + (Name & Badge Row + Location & Time Row) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivAuthorAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/shape_avatar_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Row 1: Author Name on Left, Category Badge & 3-Dots on Right -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvAuthorName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-black"
                        android:maxLines="1"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        tools:text="SHRIKANT RAJGOR" />

                    <!-- Category Badge -->
                    <LinearLayout
                        android:id="@+id/llCategoryBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="25dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_badge_announcement"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:id="@+id/ivCategoryIcon"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:src="@drawable/ic_post_cat_announcement"
                            app:tint="@color/primary" />

                        <TextView
                            android:id="@+id/tvCategoryText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/primary"
                            android:textSize="11sp"
                            tools:text="Announcement" />

                    </LinearLayout>

                    <!-- 3-Dots More Options Menu -->
                    <ImageView
                        android:id="@+id/btnMoreMenu"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Options"
                        android:padding="3dp"
                        android:src="@drawable/ic_more_vert"
                        app:tint="#94A3B8" />

                </LinearLayout>

                <!-- Row 2: Location Pin, Location Text, Dot, Time Ago -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivLocationPin"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_location"
                        app:tint="#6366F1" />

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        tools:text="Bhujpur, Kutch" />

                    <TextView
                        android:id="@+id/tvDot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:fontFamily="sans-serif"
                        android:text="•"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvTimeAgo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:singleLine="true"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        tools:text="3h ago" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Content Body Row (2-column layout when thumbnail is present) -->
        <LinearLayout
            android:id="@+id/llContentRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="top"
            android:orientation="horizontal">

            <!-- Text Column -->
            <LinearLayout
                android:id="@+id/llTextColumn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPostTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-bold"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:textColor="#0F172A"
                    android:textSize="15.5sp"
                    tools:text="Vavajodo ache to" />

                <TextView
                    android:id="@+id/tvPostDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="3"
                    android:textColor="#475569"
                    android:textSize="13sp"
                    tools:text="Be safe everyone. Strong winds are expected in our area. Please take necessary precautions. 🙏" />

            </LinearLayout>

            <!-- Media Thumbnail Container (Right side) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardThumbnail"
                android:layout_width="106dp"
                android:layout_height="80dp"
                android:layout_marginStart="12dp"
                android:visibility="visible"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="#EEF2F6"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/ivPostThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#F1F5F9"
                    android:contentDescription="Post Media"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/bg_image_placeholder" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Footer Row: Likes, Comments, Share | Views, Edit Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Likes -->
            <LinearLayout
                android:id="@+id/btnLike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/ivLikeIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_favorite_border"
                    app:tint="#64748B" />

                <TextView
                    android:id="@+id/tvLikesCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    tools:text="25" />

            </LinearLayout>

            <!-- Comments -->
            <LinearLayout
                android:id="@+id/btnComment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/ivCommentIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chat_bubble"
                    app:tint="#64748B" />

                <TextView
                    android:id="@+id/tvCommentsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    tools:text="8" />

            </LinearLayout>

            <!-- Share -->
            <LinearLayout
                android:id="@+id/btnShare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/ivShareIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_share"
                    app:tint="#64748B" />

                <TextView
                    android:id="@+id/tvShareText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Share"
                    android:textColor="#64748B"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Flexible Space -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Edit Button (Green Outlined Pill) -->
            <TextView
                android:id="@+id/btnEditPost"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_btn_edit_outline"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minWidth="66dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Edit"
                android:textColor="@color/primary"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
