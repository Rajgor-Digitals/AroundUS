<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <!-- Left Hamburger Menu Button -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_profile_header_btn"
            android:contentDescription="Menu"
            android:padding="8dp"
            android:src="@drawable/ic_menu_custom"
            app:tint="#1E293B" />

        <!-- Center Title & Subtitle -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Messages"
                android:textColor="#0F172A"
                android:textSize="19sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_unread_badge"
                    android:backgroundTint="#16A34A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Stay connected with your community"
                    android:textColor="#64748B"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Compose Button -->
        <ImageButton
            android:id="@+id/btnCompose"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_profile_header_btn"
            android:contentDescription="New Message"
            android:padding="8dp"
            android:src="@drawable/ic_edit"
            app:tint="#0D8A3F" />

    </RelativeLayout>

    <!-- Search Bar -->
    <LinearLayout
        android:id="@+id/searchBarContainer"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_chat_search_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Search"
            android:src="@drawable/ic_search"
            app:tint="#94A3B8" />

        <EditText
            android:id="@+id/etSearchMessages"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search messages..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:textSize="13.5sp" />

        <ImageButton
            android:id="@+id/btnFilter"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Filter"
            android:padding="2dp"
            android:src="@drawable/ic_tune_filter"
            app:tint="#0D8A3F" />
    </LinearLayout>

    <!-- 3 Segment Tabs: Chats, Groups, Announcements -->
    <LinearLayout
        android:id="@+id/llTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Chats Tab (Active) -->
        <LinearLayout
            android:id="@+id/tabChats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivTabChatsIcon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/ic_chat_bubble"
                    app:tint="#0D8A3F" />

                <TextView
                    android:id="@+id/tvTabChatsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Chats"
                    android:textColor="#0D8A3F"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:id="@+id/indicatorChats"
                android:layout_width="match_parent"
                android:layout_height="2.5dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chat_tab_indicator" />
        </LinearLayout>

        <!-- Groups Tab -->
        <LinearLayout
            android:id="@+id/tabGroups"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivTabGroupsIcon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/ic_group"
                    app:tint="#64748B" />

                <TextView
                    android:id="@+id/tvTabGroupsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Groups"
                    android:textColor="#64748B"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:id="@+id/indicatorGroups"
                android:layout_width="match_parent"
                android:layout_height="2.5dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chat_tab_indicator"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- Announcements Tab -->
        <LinearLayout
            android:id="@+id/tabAnnouncements"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivTabAnnouncementsIcon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/ic_announcements_megaphone"
                    app:tint="#64748B" />

                <TextView
                    android:id="@+id/tvTabAnnouncementsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Announcements"
                    android:textColor="#64748B"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:id="@+id/indicatorAnnouncements"
                android:layout_width="match_parent"
                android:layout_height="2.5dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chat_tab_indicator"
                android:visibility="invisible" />
        </LinearLayout>

    </LinearLayout>

    <!-- Hairline divider under tabs -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

    <!-- Subheader: All Conversations ▾ & Sort -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/llFilterSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFilterLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="All Conversations"
                android:textColor="#0F172A"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="▾"
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSort"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="Sort"
            android:src="@drawable/ic_sort_filter"
            app:tint="#64748B" />

    </RelativeLayout>

    <!-- Conversations RecyclerView with Pull-To-Refresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChats"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="72dp"
            android:scrollbars="none" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
