<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="36dp">

        <!-- 1. Top Header Bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:paddingStart="16dp"
            android:paddingTop="36dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <!-- Hamburger Menu Button -->
            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menu"
                android:src="@drawable/ic_menu_hamburger"
                app:layout_constraintBottom_toBottomOf="@id/llHeaderBrand"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/llHeaderBrand" />

            <!-- Brand Logo Typography -->
            <LinearLayout
                android:id="@+id/llHeaderBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Around "
                        android:textColor="#111827"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Us"
                        android:textColor="#0D8A3F"
                        android:textSize="22sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-2dp"
                    android:fontFamily="sans-serif"
                    android:text="Your Community. Connected."
                    android:textColor="#64748B"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Right Actions: Search & Notifications with Green Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="@id/llHeaderBrand"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/llHeaderBrand">

                <ImageButton
                    android:id="@+id/btnSearch"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Search"
                    android:src="@drawable/ic_search"
                    app:tint="#111827" />

                <FrameLayout
                    android:id="@+id/btnNotifications"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="Notifications"
                        android:src="@drawable/ic_bell_outlined" />

                    <TextView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/shape_circle_primary"
                        android:backgroundTint="#0D8A3F"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <!-- Location Selector Bar -->
            <LinearLayout
                android:id="@+id/btnLocationPicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/llHeaderBrand">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Location Pin"
                    android:src="@drawable/ic_location"
                    app:tint="#0D8A3F" />

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Bhujpur, Kutch, Gujarat"
                    android:textColor="#111827"
                    android:textSize="13.5sp" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="Dropdown"
                    android:rotation="90"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#64748B" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 2. Hero Banner Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/heroBannerCard"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="#F0FDF4"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:strokeColor="#DCFCE7"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Background Panoramic Illustration (Houses on Right, Pale Sky on Left) -->
                <ImageView
                    android:id="@+id/ivBannerGraphic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Neighborhood Illustration"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_home_hero_banner_exact" />

                <!-- Left Content Overlay with Balanced Spacing -->
                <LinearLayout
                    android:layout_width="210dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:text="Stronger\nNeighborhoods,"
                        android:textColor="#111827"
                        android:textSize="15.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:text="Better Together."
                        android:textColor="#0D8A3F"
                        android:textSize="15.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="1dp"
                        android:text="Connect, share and stay updated with what matters in your area."
                        android:textColor="#475569"
                        android:textSize="10sp" />

                    <!-- Explore Now Pill Button -->
                    <LinearLayout
                        android:id="@+id/btnExploreNow"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_emerald_pill_button"
                        android:clickable="true"
                        android:elevation="2dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:includeFontPadding="false"
                            android:text="Explore Now"
                            android:textColor="#FFFFFF"
                            android:textSize="11.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="→"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Carousel Dots Indicator -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="14dp"
                        android:layout_height="4.5dp"
                        android:background="@drawable/shape_circle_primary"
                        android:backgroundTint="#0D8A3F" />

                    <View
                        android:layout_width="4.5dp"
                        android:layout_height="4.5dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/shape_circle_primary"
                        android:backgroundTint="#CBD5E1" />

                    <View
                        android:layout_width="4.5dp"
                        android:layout_height="4.5dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/shape_circle_primary"
                        android:backgroundTint="#CBD5E1" />

                    <View
                        android:layout_width="4.5dp"
                        android:layout_height="4.5dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/shape_circle_primary"
                        android:backgroundTint="#CBD5E1" />
                </LinearLayout>

            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Category / Quick Actions Row (6 Badges) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 1. Announcements -->
                <LinearLayout
                    android:id="@+id/catAnnouncements"
                    android:layout_width="86dp"
                    android:layout_height="78dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_category_card"
                    android:clickable="true"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="Announcements"
                        android:src="@drawable/ic_announcements_megaphone" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Announcements"
                        android:textColor="#334155"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <!-- 2. Help & Support -->
                <LinearLayout
                    android:id="@+id/catHelpSupport"
                    android:layout_width="86dp"
                    android:layout_height="78dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_category_card"
                    android:clickable="true"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="Help &amp; Support"
                        android:src="@drawable/ic_help_heart" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Help &amp; Support"
                        android:textColor="#334155"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <!-- 3. Buy / Sell -->
                <LinearLayout
                    android:id="@+id/catBuySell"
                    android:layout_width="86dp"
                    android:layout_height="78dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_category_card"
                    android:clickable="true"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="Buy / Sell"
                        android:src="@drawable/ic_shopping_bag" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Buy / Sell"
                        android:textColor="#334155"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <!-- 4. Events -->
                <LinearLayout
                    android:id="@+id/catEvents"
                    android:layout_width="86dp"
                    android:layout_height="78dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_category_card"
                    android:clickable="true"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="Events"
                        android:src="@drawable/ic_event_calendar" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Events"
                        android:textColor="#334155"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <!-- 5. Services -->
                <LinearLayout
                    android:id="@+id/catServices"
                    android:layout_width="86dp"
                    android:layout_height="78dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_category_card"
                    android:clickable="true"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="Services"
                        android:src="@drawable/ic_tools_wrench" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Services"
                        android:textColor="#334155"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <!-- 6. More -->
                <LinearLayout
                    android:id="@+id/catMore"
                    android:layout_width="86dp"
                    android:layout_height="78dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_category_card"
                    android:clickable="true"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="More"
                        android:src="@drawable/ic_grid_more" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="More"
                        android:textColor="#334155"
                        android:textSize="9.5sp" />
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- 4. Announcements Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <!-- Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:text="Announcements"
                    android:textColor="#111827"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/btnViewAllAnnouncements"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:padding="4dp"
                    android:text="View All >"
                    android:textColor="#0D8A3F"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- Dynamic Announcements RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAnnouncements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:scrollbars="none" />
        </LinearLayout>

        <!-- 5. Community Posts Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <!-- Section Header & Filter Tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:text="Community Posts"
                    android:textColor="#111827"
                    android:textSize="18sp" />

                <!-- Tabs: Recent, Popular, Nearby -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/tabRecent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp">

                        <TextView
                            android:id="@+id/tvTabRecent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="Recent"
                            android:textColor="#0D8A3F"
                            android:textSize="13sp" />

                        <View
                            android:id="@+id/indicatorRecent"
                            android:layout_width="28dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="2dp"
                            android:background="#0D8A3F" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tabPopular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:padding="6dp"
                        android:text="Popular"
                        android:textColor="#64748B"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tabNearby"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:padding="6dp"
                        android:text="Nearby"
                        android:textColor="#64748B"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Dynamic Posts RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
