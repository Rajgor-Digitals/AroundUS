<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="start">

    <!-- Main App Content Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <!-- NavHostFragment taking full height above the bottom bar -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/navHostFragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:defaultNavHost="true"
            app:layout_constraintBottom_toTopOf="@id/bottomBarContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:navGraph="@navigation/nav_graph" />

        <!-- Bottom Navigation Bar Container with Top Divider and Elevation -->
        <FrameLayout
            android:id="@+id/bottomBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:elevation="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:id="@+id/customBottomBar"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:background="@color/surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="4dp">

                <!-- 1. Home Item -->
                <LinearLayout
                    android:id="@+id/navHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivNavHome"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_home"
                        app:tint="#0D8A3F" />

                    <TextView
                        android:id="@+id/tvNavHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Home"
                        android:textColor="#0D8A3F"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 2. Groups Item -->
                <LinearLayout
                    android:id="@+id/navGroups"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivNavGroups"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_group"
                        app:tint="#64748B" />

                    <TextView
                        android:id="@+id/tvNavGroups"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Groups"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 3. Center Post FAB -->
                <LinearLayout
                    android:id="@+id/navPost"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_fab_circle_green"
                        android:elevation="3dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_add"
                            app:tint="#FFFFFF" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvNavPost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Post"
                        android:textColor="#64748B"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <!-- 4. Messages Item -->
                <LinearLayout
                    android:id="@+id/navMessages"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/ivNavMessages"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_chat_bubble"
                            app:tint="#64748B" />

                        <TextView
                            android:id="@+id/tvNavMessagesBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:minWidth="16dp"
                            android:layout_gravity="top|end"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="-4dp"
                            android:layout_marginEnd="-8dp"
                            android:background="@drawable/bg_bottom_nav_badge"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:textColor="#FFFFFF"
                            android:textSize="9.5sp"
                            android:visibility="gone"
                            tools:text="3"
                            tools:visibility="visible" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvNavMessages"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Messages"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 5. Profile Item -->
                <LinearLayout
                    android:id="@+id/navProfile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivNavProfile"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_person"
                        app:tint="#64748B" />

                    <TextView
                        android:id="@+id/tvNavProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Profile"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Side Navigation Drawer -->
    <include
        android:id="@+id/navigationDrawer"
        layout="@layout/layout_navigation_drawer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
