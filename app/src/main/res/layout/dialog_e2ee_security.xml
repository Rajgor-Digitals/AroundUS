<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_new_convo"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_sheet_drag_handle" />

    <!-- Security Header with Glowing Lock Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_circle_green_light">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="Encryption Shield"
                android:src="@drawable/ic_lock"
                app:tint="#16A34A" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-bold"
            android:text="End-to-End Encrypted"
            android:textColor="#0F172A"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvSecuritySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:text="Secured with 256-bit AES-GCM"
            android:textColor="#16A34A"
            android:textSize="12.5sp" />

    </LinearLayout>

    <!-- Info Explanation Box -->
    <TextView
        android:id="@+id/tvSecurityDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_e2ee_security_pill"
        android:lineSpacingExtra="3dp"
        android:padding="12dp"
        android:textColor="#065F46"
        android:textSize="12.5sp"
        tools:text="Messages and inquiries in this chat are end-to-end encrypted. No one outside of this chat, not even AroundUS, can read them." />

    <!-- Safety Number Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_rounded_card"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Verified"
                android:src="@drawable/ic_shield_check"
                app:tint="#16A34A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.04"
                android:text="SECURITY VERIFICATION CODE"
                android:textColor="#64748B"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSafetyNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#F8FAFC"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:lineSpacingExtra="4dp"
            android:padding="10dp"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="48201 92834 19283 84729\n01928 37462 82910 47291\n73910 48291 03829 48192" />

        <TextView
            android:id="@+id/tvSafetyNumberHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:textColor="#64748B"
            android:textSize="11sp"
            tools:text="Compare this 60-digit number with your neighbor to verify that end-to-end encryption is active and keys match." />

    </LinearLayout>

    <!-- Cryptographic Specification Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_e2ee_chip"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="🔒 AES-256-GCM"
            android:textColor="#334155"
            android:textSize="10.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_e2ee_chip"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="🛡️ 128-bit AEAD Tag"
            android:textColor="#334155"
            android:textSize="10.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_e2ee_chip"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="🔑 SHA-256"
            android:textColor="#334155"
            android:textSize="10.5sp" />

    </LinearLayout>

    <!-- Close Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDoneSecurity"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_green_primary_button"
        android:fontFamily="sans-serif-bold"
        android:text="Done"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

</LinearLayout>
