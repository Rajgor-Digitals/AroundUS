<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top Gradient Header -->
    <View
        android:id="@+id/topDecor"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:background="@drawable/bg_gradient_splash"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/shape_circle_primary"
        android:backgroundTint="#33FFFFFF"
        android:contentDescription="Back"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFF" />

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:fontFamily="sans-serif-black"
        android:text="Forgot Password?"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="36dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card"
                style="@style/Widget.AroundUS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="26dp"
                app:cardElevation="8dp"
                app:strokeColor="#F1F5F9"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <!-- STEP 1: REQUEST RESET LINK -->
                    <LinearLayout
                        android:id="@+id/layoutRequestLink"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Reset Your Password"
                            android:textColor="#0F172A"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="24dp"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="3dp"
                            android:text="Enter your registered email address. We'll send you a password reset link to create a new password."
                            android:textColor="#64748B"
                            android:textSize="13.5sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilEmail"
                            style="@style/Widget.AroundUS.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_email"
                            app:startIconDrawable="@drawable/ic_mail"
                            app:startIconTint="#0D8A3F">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textEmailAddress"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSendReset"
                                style="@style/Widget.AroundUS.Button.Primary"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:background="@drawable/bg_primary_button"
                                android:fontFamily="sans-serif-medium"
                                android:text="Send Reset Link"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                app:backgroundTint="@null" />

                            <ProgressBar
                                android:id="@+id/pbLoadingSend"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:indeterminateTint="#FFFFFF"
                                android:visibility="gone" />
                        </FrameLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBackToLogin"
                            style="@style/Widget.AroundUS.Button.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Back to Sign In"
                            android:textColor="#0D8A3F"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- STEP 2: LINK SENT CONFIRMATION -->
                    <LinearLayout
                        android:id="@+id/layoutLinkSent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingVertical="8dp"
                        android:visibility="gone">

                        <FrameLayout
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:background="@drawable/bg_circle_green_light">

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_mail"
                                app:tint="#0D8A3F" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="sans-serif-black"
                            android:text="Check Your Email"
                            android:textColor="#0F172A"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif"
                            android:text="We sent a password reset link to:"
                            android:textColor="#64748B"
                            android:textSize="13.5sp" />

                        <!-- Target Email Badge -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/bg_e2ee_security_pill"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp">

                            <TextView
                                android:id="@+id/tvSentEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="user@example.com"
                                android:textColor="#0D8A3F"
                                android:textSize="13.5sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="22dp"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                            android:lineSpacingExtra="3dp"
                            android:text="Click the link in the email from this phone to reset your password. The link will open AroundUS automatically."
                            android:textColor="#64748B"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenEmailApp"
                            style="@style/Widget.AroundUS.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_primary_button"
                            android:fontFamily="sans-serif-medium"
                            android:text="Open Email App"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            app:backgroundTint="@null" />

                        <TextView
                            android:id="@+id/tvResendLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:padding="8dp"
                            android:text="Didn't get the email? Resend link"
                            android:textColor="#0D8A3F"
                            android:textSize="13.5sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBackFromSent"
                            style="@style/Widget.AroundUS.Button.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Back to Sign In"
                            android:textColor="#64748B"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                    <!-- STEP 3: SET NEW PASSWORD (REACHED VIA LINK) -->
                    <LinearLayout
                        android:id="@+id/layoutSetNewPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Create New Password"
                            android:textColor="#0F172A"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvResetTargetEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="20dp"
                            android:fontFamily="sans-serif"
                            android:text="Choose a new password for your account."
                            android:textColor="#64748B"
                            android:textSize="13.5sp" />

                        <!-- New Password -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilNewPassword"
                            style="@style/Widget.AroundUS.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="New Password"
                            app:passwordToggleEnabled="true"
                            app:startIconDrawable="@drawable/ic_lock"
                            app:startIconTint="#0D8A3F">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etNewPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Confirm New Password -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilConfirmPassword"
                            style="@style/Widget.AroundUS.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:hint="Confirm New Password"
                            app:passwordToggleEnabled="true"
                            app:startIconDrawable="@drawable/ic_lock"
                            app:startIconTint="#0D8A3F">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etConfirmPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif"
                            android:text="• Minimum 6 characters required"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="22dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnUpdatePassword"
                                style="@style/Widget.AroundUS.Button.Primary"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:background="@drawable/bg_primary_button"
                                android:fontFamily="sans-serif-medium"
                                android:text="Save New Password"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                app:backgroundTint="@null" />

                            <ProgressBar
                                android:id="@+id/pbLoadingUpdate"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:indeterminateTint="#FFFFFF"
                                android:visibility="gone" />
                        </FrameLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancelUpdate"
                            style="@style/Widget.AroundUS.Button.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Cancel"
                            android:textColor="#64748B"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                    <!-- STEP 4: SUCCESS SCREEN -->
                    <LinearLayout
                        android:id="@+id/layoutSuccess"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingVertical="12dp"
                        android:visibility="gone">

                        <FrameLayout
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:background="@drawable/bg_circle_green_light">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_check_circle"
                                app:tint="#0D8A3F" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:fontFamily="sans-serif-black"
                            android:text="Password Reset!"
                            android:textColor="#0F172A"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="24dp"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                            android:lineSpacingExtra="3dp"
                            android:text="Your account password has been updated successfully. You can now log in with your new password."
                            android:textColor="#64748B"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSuccessSignIn"
                            style="@style/Widget.AroundUS.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_primary_button"
                            android:fontFamily="sans-serif-medium"
                            android:text="Sign In to AroundUS"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            app:backgroundTint="@null" />
                    </LinearLayout>

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
