<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="90dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Image Carousel Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="320dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPagerImages"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Toolbar Overlay -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp">

                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_glass_circle"
                        android:contentDescription="Back"
                        android:elevation="4dp"
                        android:padding="9dp"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="#0F172A" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnShare"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_glass_circle"
                            android:contentDescription="Share"
                            android:elevation="4dp"
                            android:padding="9dp"
                            android:src="@drawable/ic_share"
                            app:tint="#0F172A" />

                        <ImageButton
                            android:id="@+id/btnSave"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_glass_circle"
                            android:contentDescription="Save"
                            android:elevation="4dp"
                            android:padding="9dp"
                            android:src="@drawable/ic_bookmark_outline"
                            app:tint="#0F172A" />

                    </LinearLayout>

                </RelativeLayout>

                <!-- Image Counter Badge (Bottom-Right) -->
                <TextView
                    android:id="@+id/tvImageCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_circle_dark_translucent"
                    android:elevation="2dp"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    tools:text="1/3" />

                <!-- Dots indicator -->
                <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
                    android:id="@+id/dotsIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="16dp"
                    app:dotsColor="#0D8A3F"
                    app:dotsSize="6dp" />

            </FrameLayout>

            <!-- Product Header Details Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Price & Status Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPrice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="#0D8A3F"
                        android:textSize="26sp"
                        tools:text="₹2,400" />

                    <!-- Negotiable Badge -->
                    <TextView
                        android:id="@+id/badgeNegotiable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_location_pill"
                        android:backgroundTint="#F0FDF4"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="8dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="4dp"
                        android:text="Negotiable"
                        android:textColor="#0D8A3F"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <!-- Condition Badge -->
                    <TextView
                        android:id="@+id/chipCondition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_location_pill"
                        android:backgroundTint="#F1F5F9"
                        android:fontFamily="sans-serif-bold"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp"
                        android:textColor="#0F172A"
                        android:textSize="12sp"
                        tools:text="Like New" />

                </LinearLayout>

                <!-- Product Name -->
                <TextView
                    android:id="@+id/tvProductName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-bold"
                    android:lineSpacingExtra="3dp"
                    android:textColor="#0F172A"
                    android:textSize="19sp"
                    tools:text="Solid Teak Wood Study Desk" />

                <!-- Location & Posted Date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="Location"
                        android:src="@drawable/ic_location"
                        app:tint="#0D8A3F" />

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#0D8A3F"
                        android:textSize="13sp"
                        tools:text="Bhujpur Village, Kutch" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvTimeAgo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        tools:text="Posted 1h ago" />

                </LinearLayout>

            </LinearLayout>

            <!-- Description Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Item Description"
                    android:textColor="#0F172A"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingMultiplier="1.4"
                    android:textColor="#334155"
                    android:textSize="14sp"
                    tools:text="Solid teak wood study desk with 2 storage drawers. Perfectly kept, no scratches." />

                <!-- Category and Brand metadata -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCategoryMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_location_pill"
                        android:backgroundTint="#F8FAFC"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:textColor="#475569"
                        android:textSize="11.5sp"
                        tools:text="Category: Furniture" />

                    <TextView
                        android:id="@+id/tvBrandMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_location_pill"
                        android:backgroundTint="#F8FAFC"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:textColor="#475569"
                        android:textSize="11.5sp"
                        android:visibility="gone"
                        tools:text="Brand: Trek"
                        tools:visibility="visible" />

                </LinearLayout>

            </LinearLayout>

            <!-- Seller Information Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Listed by Local Neighbor"
                    android:textColor="#0F172A"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivSellerAvatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/shape_avatar_placeholder" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvSellerName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="#0F172A"
                                android:textSize="15sp"
                                tools:text="Gaurav Rajgor" />

                            <ImageView
                                android:id="@+id/ivSellerVerified"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="6dp"
                                android:contentDescription="Verified"
                                android:src="@drawable/ic_verified_badge"
                                app:tint="#0D8A3F" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:text="Verified Neighbor · Bhujpur Village"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Safety & Zero Commission Notice -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:background="@drawable/bg_tc_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Shield"
                    android:src="@drawable/ic_shield_check"
                    app:tint="#0D8A3F" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:text="AroundUS is 100% free with zero commission. Always inspect items in person in safe public local areas before exchanging payment."
                    android:textColor="#065F46"
                    android:textSize="11.5sp" />

            </LinearLayout>

            <!-- Report Listing Action -->
            <TextView
                android:id="@+id/btnReportListing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:fontFamily="sans-serif-medium"
                android:padding="8dp"
                android:text="🚩 Report this listing"
                android:textColor="#94A3B8"
                android:textSize="12.5sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Sticky Action Bar -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Buyer Action: Chat with Seller -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChatWithSeller"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:fontFamily="sans-serif-bold"
            android:text="Contact Seller"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:backgroundTint="#0D8A3F"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_message"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF" />

        <!-- Seller/Owner Actions (Shown only if current user is the seller) -->
        <LinearLayout
            android:id="@+id/layoutOwnerActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkStatus"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:text="Mark as Sold"
                android:textColor="#0D8A3F"
                app:cornerRadius="24dp"
                app:strokeColor="#0D8A3F" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteListing"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:text="Delete"
                android:textColor="#EF4444"
                app:cornerRadius="24dp"
                app:strokeColor="#EF4444" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
