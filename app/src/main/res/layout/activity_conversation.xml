<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <!-- Top Chat Header Bar -->
    <LinearLayout
        android:id="@+id/chatHeader"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <!-- Back Button with Green Chevron -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_chevron_left"
            app:tint="#0D8A3F" />

        <!-- Avatar Container -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/shape_avatar_placeholder" />

            <TextView
                android:id="@+id/tvAvatarInitial"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_letter_avatar_green"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:visibility="gone"
                tools:text="R" />

            <View
                android:id="@+id/onlineIndicator"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_online_dot" />

        </FrameLayout>

        <!-- Name and Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:textColor="#0F172A"
                android:textSize="15.5sp"
                tools:text="Priya Sharma" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dotStatus"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_unread_badge"
                    android:backgroundTint="#16A34A" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#16A34A"
                    android:textSize="11.5sp"
                    tools:text="Active now" />
            </LinearLayout>

        </LinearLayout>

        <!-- Call Button (Green) -->
        <ImageButton
            android:id="@+id/btnCall"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Call"
            android:padding="8dp"
            android:src="@drawable/ic_phone_outlined"
            app:tint="#0D8A3F" />

        <!-- More Options Button -->
        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="More"
            android:padding="8dp"
            android:src="@drawable/ic_more_vert"
            app:tint="#64748B" />

    </LinearLayout>

    <!-- Hairline Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

    <!-- Chat Messages & Timeline Section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="48dp"
            android:paddingBottom="12dp"
            android:scrollbars="none" />

        <!-- Date Header Pill (e.g. Today) -->
        <TextView
            android:id="@+id/tvDateHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_date_pill"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="14dp"
            android:paddingTop="3dp"
            android:paddingEnd="14dp"
            android:paddingBottom="3dp"
            android:text="Today"
            android:textColor="#64748B"
            android:textSize="11sp" />

    </RelativeLayout>

    <!-- Hairline Divider Above Input Bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

    <!-- Bottom Message Input Bar -->
    <LinearLayout
        android:id="@+id/messageInputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <!-- Attachment / Plus Button -->
        <ImageButton
            android:id="@+id/btnAttach"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_plus"
            android:contentDescription="Attach"
            android:padding="8dp"
            android:src="@drawable/ic_add"
            app:tint="#0D8A3F" />

        <!-- Rounded Input Pill -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_input_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Type a message..."
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnEmoji"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Emoji"
                android:padding="5dp"
                android:src="@drawable/ic_emoji_smile"
                app:tint="#94A3B8" />

        </LinearLayout>

        <!-- Microphone / Send Button Container -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">

            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Voice Message"
                android:padding="8dp"
                android:src="@drawable/ic_mic"
                app:tint="#0D8A3F" />

            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_unread_badge"
                android:contentDescription="Send"
                android:padding="9dp"
                android:src="@drawable/ic_send"
                android:visibility="gone"
                app:tint="#FFFFFF" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
