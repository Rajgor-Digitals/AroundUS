<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

     <application
        android:name=".AroundUsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.AroundUS"
        tools:targetApi="31">

        <!-- Splash Screen -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AroundUS.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding -->
        <activity
            android:name=".activities.OnboardingActivity"
            android:exported="false" />

        <!-- Auth Activities -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.ForgotPasswordActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.ProfileSetupActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- OAuth Callback Activity (Supabase Google Sign-In & Password Recovery) -->
        <activity
            android:name=".activities.AuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AroundUS">
            <!-- aroundus://auth/callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="auth"
                    android:pathPrefix="/callback"
                    android:scheme="aroundus" />
            </intent-filter>

            <!-- aroundus://reset-password -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="reset-password"
                    android:scheme="aroundus" />
            </intent-filter>

            <!-- aroundus://login-callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="login-callback"
                    android:scheme="aroundus" />
            </intent-filter>

            <!-- com.aroundus.app://auth -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="auth"
                    android:scheme="com.aroundus.app" />
            </intent-filter>

            <!-- com.aroundus.app://login-callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="login-callback"
                    android:scheme="com.aroundus.app" />
            </intent-filter>

            <!-- http://localhost:3000 fallback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="localhost"
                    android:port="3000"
                    android:scheme="http" />
            </intent-filter>

            <!-- https://localhost:3000 fallback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="localhost"
                    android:port="3000"
                    android:scheme="https" />
            </intent-filter>

            <!-- http://127.0.0.1:3000 fallback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="127.0.0.1"
                    android:port="3000"
                    android:scheme="http" />
            </intent-filter>
        </activity>

        <!-- Main Activity -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Conversation Activity -->
        <activity
            android:name=".activities.ConversationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Terms and Conditions Activity -->
        <activity
            android:name=".activities.TermsAndConditionsActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <!-- Full-Screen Media Viewer Activity -->
        <activity
            android:name=".activities.FullScreenImageViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.AroundUS" />

    </application>

</manifest>
